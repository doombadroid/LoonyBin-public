// Altis Life game mechanic — fictional in-game "quickhack" ability, game logic only
/*
    File: fn_cyberdeckHome.sqf  (life_fnc_cyberdeckHome)
    LooneyBin 2026-07-19: Cyberdeck HOME MENU driver -- the ICEBREAKER app-grid on Custom 20 (replaces the scroll
    wheel). The dialog (cyberdeck_home.hpp, generated by scratchpad/build_cyberdeck_home.py) is a baked PAA deck
    with 9 invisible hit-buttons pixel-aligned to the tiles + per-tile dim overlays + a live target strip. The
    target aimed at on the keypress is captured into PLB_cdTarget (fn_keyUpHandler) before the mouse frees.
    This just: writes the locked target into the strip, and greys/disables the exploits that don't apply to it.
    A tile click -> life_fnc_cyberdeckLaunch runs that hack on the captured target (onButtonClick baked in the hpp).
*/
disableSerialization;
if (!(call PLB_fnc_hasDeck)) exitWith { ["You don't have a Cyberdeck.", "basic"] spawn life_fnc_handleMessage; };
if (playerSide isEqualTo west) exitWith { ["The Cyberdeck's ICE locks out law-enforcement credentials.", "basic"] spawn life_fnc_handleMessage; };

private _tgt = missionNamespace getVariable ["PLB_cdTarget", objNull];
if !(createDialog "cyberdeck_home") exitWith {};
private _d = findDisplay 941100;
if (isNull _d) exitWith {};

// ---- classify the locked target (menu hint -- each hack still re-checks + the server authorises) ----
private _tt = if (isNull _tgt) then { "" } else { typeOf _tgt };
private _isVeh   = (!isNull _tgt) && {(_tgt isKindOf "Car") || (_tgt isKindOf "Air") || (_tgt isKindOf "Ship")} && {!(_tgt isKindOf "CAManBase")};
private _isHouse = (!isNull _tgt) && {_tgt isKindOf "House_F"} && {_tt in life_houseTypes};
private _isRig   = (!isNull _tgt) && {_tgt getVariable ["plb_cryptoRig", false]};
private _isSafe  = _tt in ["Land_Research_house_V1_F", "Land_Research_HQ_F"];
private _isDome  = _tt in ["Land_Dome_Big_F", "Land_Dome_Small_F"];
private _isATM   = _tt in ["Land_Atm_01_F", "Land_Atm_02_F"];
private _nearBank = (player distance (getMarkerPos "life_bank_door")) < 5;
// tile order matches APPS / the dispatcher case ids: 0 Veh 1 Ign 2 House 3 Safe 4 Bank 5 Fed 6 Rig 7 ATM 8 Wardrive
private _valid = [_isVeh, _isVeh, _isHouse, _isSafe, _nearBank, _isDome, _isRig, _isATM, true];

// ---- live target strip (covers the baked "NO LOCK" default; bg matches the baked htarget box #0a120f) ----
private _lk = if (isNull _tgt) then {
    "<t size='1' color='#ffb020'>◈ NO LOCK</t>   <t size='0.9' color='#1f7d63'>aim at a target, then re-open</t>"} else {
    private _dn = getText (configFile >> "CfgVehicles" >> _tt >> "displayName");
    if (_dn isEqualTo "") then { _dn = _tt };
    format ["<t size='1' color='#c9e21a'>◈ LOCK &gt;&gt;</t>   <t size='1' color='#dbe7e0'>%1</t>", toUpper _dn]};
(_d displayCtrl 941103) ctrlSetStructuredText parseText _lk;

// ---- grey the exploits the locked target can't take + gate their hit-buttons ----
{private _ok = _valid select _forEachIndex;
    (_d displayCtrl (941110 + _forEachIndex)) ctrlEnable _ok;
    (_d displayCtrl (941120 + _forEachIndex)) ctrlSetBackgroundColor (if (_ok) then { [0, 0, 0, 0] } else { [0.02, 0.03, 0.028, 0.66] });
} forEach [0, 1, 2, 3, 4, 5, 6, 7, 8];
