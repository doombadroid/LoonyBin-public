// library and the firewall editor all read PLB_itemDesc, so they show the same text, sourced once.
private _blurbById = createHashMap;
{ _x params ["", "", "_bl", "", "", "", "", "", "", "", "", "", ["_rm", -1]]; if (_rm > -1) then { _blurbById set [_rm, _bl]; }; } forEach (["civ"] call life_fnc_qhCfg);
{
    _x params ["_itemId", "_pair"];                 // toArray false -> [key, value] pairs (no HashMap _x/_y ambiguity)
    _pair params ["_numId", "_label"];
    private _mod = (PLB_cdModules select { (_x select 0) isEqualTo _numId }) param [0, []];
    private _txt = if (_mod isNotEqualTo []) then { _mod select 3 } else { _blurbById getOrDefault [_numId, _label] };
    PLB_itemDesc set [_itemId, format ["%1 -- USE to install. %2", _label, _txt]];
} forEach (PLB_chipItemMap toArray false);

// ============================ NEW DRACHMA client helpers (2026-07-23) ============================
// The wallet is server-authoritative (players.new_drachma DECIMAL(20,4), TON_fnc_ndSRV). life_ndStr holds
// the EXACT 4dp balance as a STRING; life_nd is a 32-bit float mirror kept only for legacy
// afford-checks/labels. All spend/earn flows go through the server; these are the client-side helpers.
if (isNil "life_ndStr") then { life_ndStr = "0"; };
PLB_ndPending = createHashMap;   // token -> [onOkCode, ctx, t0]
PLB_ndTokSeq = 0;
// pretty-print a 4dp ND string/number: trim trailing zeros + dot, thousands-separate the integer part.
PLB_fnc_ndText = {
    private _s = _this;
    if (_s isEqualType []) then { _s = _s param [0, "0"]; };   // callers pass [value] -- unwrap like ndFromLegacy
    if (_s isEqualType 0) then { _s = _s toFixed 4; };
    if (!(_s isEqualType "") || {_s isEqualTo ""}) exitWith { "0" };
    private _neg = false;
    if ((_s select [0,1]) isEqualTo "-") then { _neg = true; _s = _s select [1]; };
    private _parts = _s splitString ".";
    private _i = _parts param [0, "0"];
    private _f = _parts param [1, ""];
    while { count _f > 0 && { (_f select [count _f - 1, 1]) isEqualTo "0" } } do { _f = _f select [0, (count _f) - 1]; };
    private _out = ""; private _c = count _i;
    for "_k" from 0 to (_c - 1) do {
        if (_k > 0 && { ((_c - _k) mod 3) isEqualTo 0 }) then { _out = _out + ","; };
        _out = _out + (_i select [_k, 1]);
    };
    if (_f isNotEqualTo "") then { _out = _out + "." + _f; };
    if (_neg) then { _out = "-" + _out; };
    _out
};
// convert a legacy-denominated config number (reward/price fallback) to a 4dp ND string, min 0.0001 if >0.
PLB_fnc_ndFromLegacy = {
    private _bm = _this;
    if (_bm isEqualType []) then { _bm = _bm param [0, 0]; };
    if !(_bm isEqualType 0) then { _bm = 0; };
    private _r = (round ((_bm / 6000) * 10000)) / 10000;
    if (_bm > 0 && {_r <= 0}) then { _r = 0.0001; };
    _r toFixed 4
};
// exact wallet-covers-price test (string-decimal, NO float): [priceStr|num] -> bool.
PLB_fnc_ndAfford = {
    private _price = _this;
    if (_price isEqualType []) then { _price = _price param [0, "0"]; };   // callers pass [value] -- unwrap
    if (_price isEqualType 0) then { _price = _price toFixed 4; };
    private _pad = {
        private _pp = _this splitString ".";
        private _i = _pp param [0, "0"]; private _f = _pp param [1, ""];
        while { count _f < 4 } do { _f = _f + "0"; };
        while { count _i < 16 } do { _i = "0" + _i; };
        _i + _f
    };
    private _a = toArray (life_ndStr call _pad);
    private _b = toArray (_price call _pad);
    private _ge = true;
    for "_k" from 0 to (count _a) - 1 do {
        if ((_a select _k) != (_b select _k)) exitWith { _ge = (_a select _k) > (_b select _k); };
    };
    _ge
};
// fire a server-capped credit request: [amtStr|num, reason].
PLB_fnc_ndRequest = {
    params [["_amt", "0", ["", 0]], ["_reason", "", [""]]];
    if (_amt isEqualType 0) then { _amt = _amt toFixed 4; };
    [["credit", _amt, _reason], "TON_fnc_ndSRV", 2, false] spawn life_fnc_MP;
};
// token-based purchase: [amtStr|num, onOkCode, ctx] -> token. Stashes the grant continuation, fires the
// atomic server debit, and spawns a 15s timeout sweeper. life_fnc_ndResult runs onOk on success.
PLB_fnc_ndBuy = {
    params [["_amt", "0", ["", 0]], ["_onOk", {}, [{}]], ["_ctx", [], [[]]]];
    if (_amt isEqualType 0) then { _amt = _amt toFixed 4; };
    PLB_ndTokSeq = PLB_ndTokSeq + 1;
    private _tok = format ["nd%1_%2", round (diag_tickTime * 1000), PLB_ndTokSeq];
    PLB_ndPending set [_tok, [_onOk, _ctx, diag_tickTime]];
    life_action_in_use = true;
    [["debit", _amt, _tok], "TON_fnc_ndSRV", 2, false] spawn life_fnc_MP;
    [_tok] spawn {
        params ["_tok"];
        uiSleep 15;
        if ((PLB_ndPending getOrDefault [_tok, []]) isNotEqualTo []) then {
            PLB_ndPending deleteAt _tok;
            life_action_in_use = false;
            ["New Drachma transaction timed out -- try again.", "basic"] spawn life_fnc_handleMessage;
        };
    };
    _tok
};
PLB_ndResults = createHashMap;   // token -> [ok, newStr] for blocking PLB_fnc_ndBuySync waiters
// BLOCKING purchase: [amtStr|num] -> bool (paid?). MUST run in a scheduled context (waitUntil). Keeps the
// caller's grant code straight-line: fire the atomic server debit, wait for life_fnc_ndResult to publish
// the outcome, return it. 15s timeout -> false (server dead / packet lost).
PLB_fnc_ndBuySync = {
    params [["_amt", "0", ["", 0]]];
    if (_amt isEqualType 0) then { _amt = _amt toFixed 4; };
    PLB_ndTokSeq = PLB_ndTokSeq + 1;
    private _tok = format ["nds%1_%2", round (diag_tickTime * 1000), PLB_ndTokSeq];
    PLB_ndResults deleteAt _tok;
    [["debit", _amt, _tok], "TON_fnc_ndSRV", 2, false] spawn life_fnc_MP;
    private _t0 = diag_tickTime;
    waitUntil { (_tok in PLB_ndResults) || {diag_tickTime - _t0 > 15} };
    private _res = PLB_ndResults getOrDefault [_tok, [false]];
    PLB_ndResults deleteAt _tok;
    _res param [0, false]
};
