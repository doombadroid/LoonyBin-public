    _txt = (_txt splitString "<>") joinString "";               // parseText safety in the thread view
    private _i = PLB_msgThreads findIf { (_x select 0) isEqualTo _who };
    private _rec = if (_i >= 0) then { PLB_msgThreads deleteAt _i } else { [_who, []] };
    (_rec select 1) pushBack [_dir, _txt, call PLB_fnc_msgStamp];
    if (count (_rec select 1) > 40) then { (_rec select 1) deleteAt 0; };
    PLB_msgThreads = [_rec] + PLB_msgThreads;                   // active thread bubbles to the top
    if (count PLB_msgThreads > 15) then { PLB_msgThreads deleteAt ((count PLB_msgThreads) - 1); };
    profileNamespace setVariable ["PLB_msgThreads", PLB_msgThreads];
    if (!isNull findDisplay 3000) then { call PLB_fnc_msgFill; };
};
PLB_fnc_msgRender = {
    disableSerialization;
    private _d = findDisplay 3000; if (isNull _d) exitWith {};
    private _lb = _d displayCtrl 3020;
    private _sel = lbCurSel _lb;
    private _view = _d displayCtrl 3021;
    if (_sel < 0) exitWith { _view ctrlSetStructuredText parseText "<t color='#4c5a55' align='center'><br/><br/>No conversation selected.<br/>Pick a thread, or choose a contact and hit SEND.</t>"; };
    private _who = _lb lbData _sel;
    private _i = PLB_msgThreads findIf { (_x select 0) isEqualTo _who };
    if (_i < 0) exitWith { _view ctrlSetStructuredText parseText "" };
    private _out = format ["<t size='0.95' font='PuristaBold' color='#c9e21a'>%1</t><br/><br/>", _who];
    private _msgs = (PLB_msgThreads select _i) select 1;
    {
        _x params ["_dir", "_txt", "_ts"];
        _out = _out + (if (_dir isEqualTo 1) then {
            format ["<t size='0.78' color='#33ffbb'>YOU</t> <t size='0.62' color='#4c5a55'>%1</t><br/><t size='0.86' color='#eef4f0'>%2</t><br/>", _ts, _txt]
        } else {
            format ["<t size='0.78' color='#c9e21a'>%1</t> <t size='0.62' color='#4c5a55'>%2</t><br/><t size='0.86' color='#eef4f0'>%3</t><br/>", _who, _ts, _txt]
        });
    } forEach _msgs;   // FULL history (store caps 40/thread); the scroll group handles overflow
    _view ctrlSetStructuredText parseText _out;
    // auto-height the child to its content + scroll the group to the NEWEST message (browser-page pattern):
    // estimate lines from <br/> count + wrap; slide the child up so its bottom sits at the group bottom.
    private _nbr = 0; private _rem = _out;
    while { (_rem find "<br") >= 0 } do { _nbr = _nbr + 1; _rem = _rem select [(_rem find "<br") + 3]; };
    private _gh1 = 2.5 * pixelH * pixelGrid;                       // one UI_GRID_H in screen units
    private _childH = ((_nbr + 4) * 0.95 * _gh1) max (11.0 * _gh1);
    private _groupH = 11.35 * _gh1;
    private _cp = ctrlPosition _view;
    _view ctrlSetPosition [_cp select 0, (0.1 * _gh1) min (_groupH - _childH), _cp select 2, _childH];
    _view ctrlCommit 0;
};
PLB_fnc_msgFill = {
    disableSerialization;
    private _d = findDisplay 3000; if (isNull _d) exitWith {};
    private _lb = _d displayCtrl 3020;
    private _keep = if ((lbCurSel _lb) >= 0) then { _lb lbData (lbCurSel _lb) } else { "" };
    lbClear _lb;
    {
        _x params ["_who", "_msgs"];
        private _last = _msgs param [(count _msgs) - 1, [0, "", ""]];
        private _snip = (_last select 1) select [0, 26];
        private _row = _lb lbAdd format ["%1  --  %2", _who, _snip];
        _lb lbSetData [_row, _who];
    } forEach PLB_msgThreads;
    if ((lbSize _lb) > 0) then {
        private _hit = 0;
        if (_keep isNotEqualTo "") then { for "_i" from 0 to ((lbSize _lb) - 1) do { if ((_lb lbData _i) isEqualTo _keep) exitWith { _hit = _i; }; }; };
        _lb lbSetCurSel _hit;
    };
    call PLB_fnc_msgRender;
};

